  {"id": "ankle_circles", "name": "Ankle Circles", "aliases": ["ankle circles", "ankle rolls"], "kind": "time", "equipment": "none", "primary": ["calves"], "secondary": [], "load": "none", "role": "stretch", "sides": 2, "hold": 30, "cue": "30s each side: slow, big circles, both directions.", "illustration": "Ankle_Circles", "steps": ["Stand tall and hold on to something steady. Lift one foot a few centimetres off the floor.", "Draw slow, big circles with your big toe: about 10 one way, then 10 the other way, moving only at the ankle.", "Switch feet. This warms the ankle up before the stretches."]},
  {"id": "knee_to_wall", "name": "Knee-to-Wall Ankle Stretch", "aliases": ["knee to wall", "ankle dorsiflexion stretch", "soleus stretch"], "kind": "time", "equipment": "none", "primary": ["calves"], "secondary": [], "load": "none", "role": "stretch", "sides": 2, "hold": 30, "illustration": "Standing_Soleus_And_Achilles_Stretch", "steps": ["Face a wall in a short lunge, front foot about a hand's width from the wall, hands on the wall.", "Keeping the front heel flat on the floor, bend the front knee forward towards the wall, in line with your second toe.", "Stop where you feel a stretch low in the calf and at the front of the ankle, and hold. As it gets easier, move the foot a little further from the wall."]},
  {"id": "wall_calf_stretch", "name": "Wall Calf Stretch (Straight Knee)", "aliases": ["wall calf stretch", "calf stretch", "gastrocnemius stretch"], "kind": "time", "equipment": "none", "primary": ["calves"], "secondary": [], "load": "none", "role": "stretch", "sides": 2, "hold": 30, "illustration": "Calf_Stretch_Hands_Against_Wall", "steps": ["Stand facing a wall with your hands on it and one foot well behind the other.", "Keep the back leg straight, its heel down and toes pointing forward.", "Bend the front knee and lean your hips towards the wall until you feel a stretch in the upper calf of the back leg. Hold."]},
  {"id": "strap_hamstring_stretch", "name": "Lying Hamstring Stretch (Strap or Towel)", "aliases": ["lying hamstring stretch", "strap hamstring stretch", "towel hamstring stretch"], "kind": "time", "equipment": "none", "primary": ["hamstrings"], "secondary": ["calves"], "load": "none", "role": "stretch", "sides": 2, "hold": 30, "illustration": "Hamstring_Stretch", "steps": ["Lie on your back with both legs straight. Loop a strap, belt or towel around the ball of one foot.", "Raise that leg, keeping the knee straight, and gently pull until you feel a stretch along the back of the thigh. Keep the other leg flat on the floor.", "Hold without bouncing, breathing slowly. Bend the knee slightly if you feel it behind the knee rather than in the muscle."]},
  {"id": "seated_hamstring_stretch", "name": "Seated Single-Leg Hamstring Stretch", "aliases": ["seated hamstring stretch", "sit and reach"], "kind": "time", "equipment": "none", "primary": ["hamstrings"], "secondary": ["lower_back"], "load": "none", "role": "stretch", "sides": 2, "hold": 30, "illustration": "Seated_Floor_Hamstring_Stretch", "steps": ["Sit with one leg straight out and the other bent, its foot against the inside of the straight leg's thigh.", "Keep your back long and lean forward from the hips towards the straight leg's foot, as if bringing your belly button to your thigh.", "Stop at a strong but comfortable stretch behind the thigh and hold. Don't round your back to reach further."]},
  {"id": "standing_hamstring_calf_stretch", "name": "Standing Hamstring and Calf Stretch", "aliases": ["standing hamstring stretch", "heel dig stretch"], "kind": "time", "equipment": "none", "primary": ["hamstrings"], "secondary": ["calves"], "load": "none", "role": "stretch", "sides": 2, "hold": 30, "illustration": "Standing_Hamstring_and_Calf_Stretch", "steps": ["Stand with one foot a short step in front, heel on the floor and toes pointing up. Bend the back knee.", "With the front leg straight, hinge forward from the hips with a long back, hands resting on the back thigh.", "Feel the stretch behind the front thigh and calf, and hold. A strap around the front foot, pulled gently, adds to the calf stretch."]}
